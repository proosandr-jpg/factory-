# Шаблон ключей. Скопировать в .env и заполнить.
# .env в git не попадает (см. .gitignore) и в чат/логи не вставляется.

# --- Agnes AI: видео (Agnes Video 2.5 Flash) и генерация аватара ---
# Где взять: https://agnes-ai.com -> личный кабинет -> API key
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
# v2.0 отключена на стороне Agnes, 2.5 (платная) требует баланса. Flash — триальный $0/с.
AGNES_VIDEO_MODEL=agnes-video-2.5-flash

# --- LLM для генерации сценария (любой OpenAI-совместимый провайдер) ---
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Локальная озвучка (Replicate не используется, токен не нужен) ---
# f5 — клонирование голоса из reference.wav (лицензия модели CC BY-NC 4.0, некоммерческое использование)
# piper — запасной вариант без клонирования
TTS_BACKEND=f5
TTS_LANGUAGE=ru

# F5-TTS: референс и его транскрипт (обязателен для клонирования)
F5_REF_AUDIO=assets/voice/reference_12s.wav
# F5_REF_TEXT=текст, который произнесён в референсе

# Запасной голос Piper (CC0), лежит в assets/voice/piper/
PIPER_VOICE=assets/voice/piper/ru_RU-dmitri-medium.onnx

# --- Ассеты ---
AVATAR_IMAGE=assets/avatar.png
